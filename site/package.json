{
  "name": "paddockjs-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --force",
    "build": "vite build && node scripts/check-built-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "coverage:check": "node scripts/check-feature-coverage.mjs",
    "check": "node --test build/*.test.mjs && npm run coverage:check && npm run build"
  },
  "dependencies": {
    "@inventure71/paddockjs": "file:..",
    "vite": "8.3.5"
  },
  "devDependencies": {
    "markdown-it": "15.0.3"
  }
}

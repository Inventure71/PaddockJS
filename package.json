{
  "name": "@inventure71/paddockjs",
  "version": "4.2.0",
  "type": "module",
  "description": "A data-driven browser F1 simulator component for host websites.",
  "license": "Apache-2.0",
  "author": "Matteo Giorgetti",
  "homepage": "https://github.com/Inventure71/PaddockJS#readme",
  "bugs": {
    "url": "https://github.com/Inventure71/PaddockJS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Inventure71/PaddockJS.git"
  },
  "keywords": [
    "f1",
    "formula-1",
    "motorsport",
    "racing",
    "simulator",
    "timing-tower",
    "pixijs",
    "ui-component"
  ],
  "sideEffects": [
    "./src/styles.css",
    "./src/placeholder.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./environment": {
      "types": "./src/environment/index.d.ts",
      "import": "./src/environment/index.js",
      "default": "./src/environment/index.js"
    },
    "./data": {
      "types": "./src/data/index.d.ts",
      "import": "./src/data/index.js",
      "default": "./src/data/index.js"
    },
    "./placeholder": {
      "types": "./src/placeholder/index.d.ts",
      "import": "./src/placeholder/index.js",
      "default": "./src/placeholder/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./placeholder.css": "./src/placeholder.css"
  },
  "files": [
    "CHANGELOG.md",
    "INSTALL_AND_UPDATE.md",
    "LICENSE",
    "assets",
    "docs/*.md",
    "examples/python/README.md",
    "examples/python/base_policy_server.py",
    "examples/python/requirements.txt",
    "src/api",
    "src/app",
    "src/config",
    "src/data",
    "src/environment",
    "src/placeholder",
    "src/rendering",
    "src/simulation",
    "src/ui",
    "src/index.d.ts",
    "src/index.js",
    "src/styles.css",
    "src/placeholder.css",
    "README.md"
  ],
  "scripts": {
    "test": "node scripts/run-vitest.mjs --slow",
    "test:fast": "node scripts/run-vitest.mjs",
    "types:check": "tsc -p tsconfig.types.json --noEmit",
    "docs:check": "node scripts/docs-check.mjs",
    "check": "npm run docs:check && npm run test:fast && npm run types:check && npm run pack:dry && npm run consumer:smoke && npm run consumer:bundle-boundaries && npm run site:ci && npm run browser:smoke:quick -- --skip-build && npm run demo:smoke -- --skip-build",
    "check:release": "npm run docs:check && npm run audit:release && npm test && npm run types:check && npm run pack:dry && npm run consumer:smoke && npm run consumer:bundle-boundaries && npm run site:ci && npm run browser:smoke:full -- --skip-build && npm run demo:smoke -- --skip-build",
    "audit:release": "npm run tools:release:ci && npm audit --audit-level=high && npm --prefix site audit --audit-level=high && npm --prefix tools/release audit --audit-level=high",
    "tools:release:ci": "npm --prefix tools/release ci",
    "pack:dry": "npm pack --dry-run",
    "consumer:smoke": "node scripts/consumer-package-smoke.mjs",
    "consumer:bundle-boundaries": "node scripts/consumer-bundle-boundaries.mjs",
    "browser:smoke": "node smoke/browser-smoke.mjs",
    "browser:smoke:quick": "node smoke/browser-smoke.mjs --quick",
    "browser:smoke:full": "node smoke/browser-smoke.mjs --full",
    "benchmark:runtime": "node scripts/benchmark-runtime-efficiency.mjs",
    "showcase:install": "npm run site:install",
    "showcase:dev": "npm run site:dev",
    "showcase:build": "npm run site:build",
    "showcase:ci": "npm run site:ci",
    "demo:install": "npm run site:install",
    "demo:dev": "npm run site:dev",
    "demo:build": "npm run site:build",
    "demo:ci": "npm run site:ci",
    "demo:smoke": "node smoke/demo-smoke.mjs",
    "changeset": "node scripts/run-changeset.mjs",
    "version-packages": "node scripts/run-changeset.mjs version",
    "release": "npm publish --provenance",
    "site:install": "npm --prefix site ci",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run check",
    "site:ci": "npm --prefix site ci && npm --prefix site run check"
  },
  "dependencies": {
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "playwright": "^1.57.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
